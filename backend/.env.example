# Generate a long random value and put the same value in the extension settings.
SHARED_SECRET=replace-with-a-long-random-secret
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Optional overrides
